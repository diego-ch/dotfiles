# theme
include theme.conf

# BEGIN_KITTY_FONTS
font_family      family="SauceCodePro Nerd Font Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS

# font config
font_size 18
modify_font baseline 1
modify_font cell_width 100%
modify_font cell_height 115%
modify_font underline_position 0

# keybinds config
include keybinds.conf

# terminal config
term xterm-256color
shell_integration enabled

# text config
copy_on_select true
text_composition_strategy legacy

# cursor config
cursor_blink_interval -1
cursor_shape underline
cursor_underline_thickness 1.0

# mouse config
mouse_hide_wait 3.0

# window config
initial_window_width 85c
initial_window_height 20c
window_border_width 5
window_margin_width 5
window_padding_width 20 20 20 20

# tab config
tab_bar_edge bottom
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template {title}{' :{}:'.format(num_windows) if num_windows > 1 else ''}
# "{fmt.fg.red}{bell_symbol}{activity_symbol}{fmt.fg.tab} {index}: {'/'.join(title.s {title}{' :{}:'.format(num_windows) if num_windows > 1 else ''}plit('/')[-2:])}"

# layouts
enabled_layouts splits,stack

# os config
enable_audio_bell no
macos_quit_when_last_window_closed yes
# macos_titlebar_color background
macos_traditional_fullscreen no
macos_show_window_title_in none
macos_option_as_alt both

# stop paste prompt
paste_actions replace-dangerous-control-codes



# BEGIN_KITTY_THEME
# Catppuccin-Latte
include current-theme.conf
# END_KITTY_THEME