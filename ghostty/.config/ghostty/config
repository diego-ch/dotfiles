# terminal
term = xterm-256color
scrollback-limit = 4294967295

# appearence
theme = "TokyoNight"

# fonts
font-size = 14
font-family = "OperatorMono Nerd Font"
font-variation = wght=300
font-variation = wdth=100
font-family-bold = "Maple Mono NF"
font-variation-bold = wght=800
font-family-italic = "Maple Mono NF"
font-variation-italic = wght=200
font-family-bold-italic = "Maple Mono NF"
font-variation-bold-italic = wght=800

# options
bold-is-bright = true
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false
confirm-close-surface = false
copy-on-select = clipboard
mouse-hide-while-typing = true
mouse-scroll-multiplier = 0.95
quit-after-last-window-closed = true
link-url = true

# cursor
adjust-cursor-thickness = 2
cursor-click-to-move = true
cursor-style = block
cursor-style-blink = true
cursor-invert-fg-bg = true

# window
window-height = 20
window-width = 120
window-padding-x = 14
window-padding-y = 14
window-vsync = true
window-save-state = never
window-inherit-font-size = true
window-title-font-family = "Maple Mono NF"

# macos
macos-option-as-alt = true
macos-secure-input-indication = false
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
macos-window-shadow = false

# integrations
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env

# keybind
keybind = alt+'=new_split:right
keybind = alt+-=new_split:down
keybind = ctrl+r=reload_config
keybind = shift+enter=text:\x1b\r
