[user]
	name = Diego Porto
	email = diego.cfporto@gmail.com
	signingkey = ~/.ssh/github.key

[init]
	defaultBranch = main

#
# view settings
#

[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto

[branch]
	sort = -committerdate

[tag]
	sort = -version:refname

#
# commit settings
#

[commit]
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = ssh-keygen

#
# main settings
#

[core]
	editor = nvim --clean

[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true

#
# command aliases
#

[alias]
	ca = commit -a
	cm = commit -m
	cam = commit -am
	d = diff
	dc = diff --cached
	l = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	p = push
	st = status
	wt = worktree

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

#
# github overrides
#

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[url "ssh://git@github.com"]
	insteadOf = "https://github.com"

#
# work overrides
#

[includeIf "gitdir:~/Work/loop-os/"]
	path = ~/Work/loop-os/gitconfig

